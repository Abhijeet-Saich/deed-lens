# Copy this file to .env and fill in your values. Never commit .env.
# Required for transcription, extraction and answers. Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATA_DIR=./data
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_GEMINI_TRANSCRIPTION=true
GEMINI_SECONDS_BETWEEN_CALLS=4
CONTEXT_K=5
HOST=0.0.0.0
PORT=8000
